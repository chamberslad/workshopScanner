# Copy this to .env and fill in your own values
# .env is gitignored and never committed

DB_PASSWORD=change-me-to-something-strong

# Tailscale auth key — generate one at https://login.tailscale.com/admin/settings/keys
# Use an "Ephemeral" key so the node is removed from your network if the container stops
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
